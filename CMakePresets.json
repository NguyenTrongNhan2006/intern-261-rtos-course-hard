{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug STM32F103",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake"
            }
        },
        {
            "name": "w1e2-o0",
            "inherits": "debug",
            "displayName": "W1E2 -O0 (current firmware)",
            "binaryDir": "${sourceDir}/build/w1e2-current-O0",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g3"
            }
        },
        {
            "name": "w1e2-o2",
            "inherits": "debug",
            "displayName": "W1E2 -O2 (current firmware)",
            "binaryDir": "${sourceDir}/build/w1e2-current-O2",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O2 -g3"
            }
        },
        {
            "name": "w2e1",
            "inherits": "debug",
            "displayName": "W2E1 I2C1 -O2",
            "binaryDir": "${sourceDir}/build/w2e1",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O2 -g3"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "w1e2-o0",
            "configurePreset": "w1e2-o0",
            "targets": [
                "w1e2"
            ]
        },
        {
            "name": "w1e2-o2",
            "configurePreset": "w1e2-o2",
            "targets": [
                "w1e2"
            ]
        },
        {
            "name": "w2e1",
            "configurePreset": "w2e1",
            "targets": [
                "w2e1"
            ]
        }
    ]
}
